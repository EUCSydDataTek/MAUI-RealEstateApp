<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RealEstateApp.Views.AddEditPropertyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:RealEstateApp.Converters"
    xmlns:fa="clr-namespace:FontAwesome"
    xmlns:models="clr-namespace:RealEstateApp.Models"
    xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:AddEditPropertyPageViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CancelSaveCommand}" Text="Cancel" />
        <ToolbarItem Command="{Binding SavePropertyCommand}" Text="Save" />
        <!-- Flashlight Button in Toolbar -->
        <ToolbarItem Command="{Binding ToggleFlashlightCommand}" Text="{Binding FlashlightButtonText}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <StackLayout>
            <!-- Battery Warning -->
            <Label
                BackgroundColor="{Binding BatteryColor}"
                FontAttributes="Bold"
                FontSize="14"
                IsVisible="{Binding IsBatteryWarningVisible}"
                Padding="10,5"
                Text="{Binding BatteryMessage}"
                TextColor="White" />
            
            <!-- Flashlight Status -->
            <Grid BackgroundColor="LightYellow" 
                  IsVisible="{Binding IsFlashlightOn}"
                  Padding="10,5">
                <Label Text="💡 Flashlight is ON - Useful for property viewing!" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="DarkOrange"
                       HorizontalOptions="Center" />
            </Grid>
            
            <!-- Status Message -->
            <Label
                BackgroundColor="{Binding StatusColor}"
                IsVisible="{Binding StatusMessage, Converter={converters:StringBoolConverter}}"
                Text="{Binding StatusMessage}" />
                
            <ScrollView VerticalOptions="FillAndExpand">
                <StackLayout Padding="15" Spacing="20">

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.Home}" />
                                <Span Text=" " />
                                <Span Text="Address*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Text="{Binding Property.Address}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.LocationArrow}" />
                                <Span Text=" " />
                                <Span Text="Location*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" 
                               FontSize="Medium" 
                               Text="{Binding Property.Latitude, StringFormat='{0:F4}'}" 
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" 
                               FontSize="Medium" 
                               Text="{Binding Property.Longitude, StringFormat='{0:F4}'}" 
                               VerticalOptions="Center" />
                        <Button Grid.Column="2" 
                                BackgroundColor="#6200ea"
                                Command="{Binding GetLocationCommand}"
                                FontFamily="FA-solid"
                                FontSize="Medium"
                                Text="{x:Static fa:IconFont.Thumbtack}"
                                TextColor="White" />
                        <Button Grid.Column="3" 
                                Command="{Binding GeocodeAddressCommand}"
                                FontFamily="FA-solid"
                                FontSize="Medium"
                                IsEnabled="{Binding IsNetworkAvailable}"
                                Text="{x:Static fa:IconFont.Home}"
                                TextColor="White">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsNetworkAvailable}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#6200ea" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsNetworkAvailable}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Gray" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.Tag}" />
                                <Span Text=" " />
                                <Span Text="Price*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry FontSize="Medium" Text="{Binding Property.Price, Converter={converters:NullableIntConverter}}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.Bed}" />
                                <Span Text=" " />
                                <Span Text="Bedrooms*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry
                        FontSize="Medium"
                        Keyboard="Numeric"
                        ReturnType="Next"
                        Text="{Binding Property.Beds, Converter={converters:NullableIntConverter}}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.Bath}" />
                                <Span Text=" " />
                                <Span Text="Bathroom" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry
                        FontSize="Medium"
                        Keyboard="Numeric"
                        ReturnType="Next"
                        Text="{Binding Property.Baths, Converter={converters:NullableIntConverter}}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.Parking}" />
                                <Span Text=" " />
                                <Span Text="Parking" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry
                        FontSize="Medium"
                        Keyboard="Numeric"
                        ReturnType="Next"
                        Text="{Binding Property.Parking, Converter={converters:NullableIntConverter}}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.Square}" />
                                <Span Text=" " />
                                <Span Text="Land Size" />
                                <Span Text=" " />
                                <Span Text="(&#x33a1;)" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Entry
                        FontSize="Medium"
                        Keyboard="Numeric"
                        ReturnType="Next"
                        Text="{Binding Property.LandSize, Converter={converters:NullableIntConverter}}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.FileAlt}" />
                                <Span Text=" " />
                                <Span Text="Description" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Editor
                        Margin="0"
                        AutoSize="TextChanges"
                        FontSize="Medium"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Keyboard="Text"
                        Text="{Binding Property.Description}" />

                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{Static fa:IconFont.UserTie}" />
                                <Span Text=" " />
                                <Span Text="Agent*" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Picker
                        FontSize="Medium"
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding Agents}"
                        SelectedItem="{Binding SelectedAgent}" />
                    
                    <Label FontSize="Medium">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span FontFamily="FA-solid" Text="{x:Static fa:IconFont.DraftingCompass}" />
                                <Span Text=" " />
                                <Span Text="Aspect" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" 
                               FontSize="Medium" 
                               Text="{Binding Property.Aspect}" 
                               Placeholder="Tap compass to detect"
                               IsReadOnly="True" />
                        <Button Grid.Column="1" 
                                BackgroundColor="#6200ea"
                                Command="{Binding GoToCompassCommand}"
                                FontFamily="FA-solid"
                                FontSize="Medium"
                                Text="{x:Static fa:IconFont.DraftingCompass}"
                                TextColor="White" />
                    </Grid>
                </StackLayout>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>