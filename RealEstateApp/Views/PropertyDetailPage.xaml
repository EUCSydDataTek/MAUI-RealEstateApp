<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RealEstateApp.Views.PropertyDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:FontAwesome"
    xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
    xmlns:converters="clr-namespace:RealEstateApp.Converters"
    Title="{Binding Property.Address}"
    x:DataType="vm:PropertyDetailPageViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding EditPropertyCommand}" Text="Edit" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Grid
            Padding="15"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="10">
            <Image
                Grid.Row="0"
                Margin="-10,-10,-10,0"
                Aspect="AspectFill"
                HeightRequest="225"
                Source="{Binding Property.MainImageUrl}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToImageListCommand}" />
                </Image.GestureRecognizers>
            </Image>
            <Label
                Grid.Row="1"
                FontAttributes="Bold"
                FontSize="16"
                LineBreakMode="NoWrap"
                Text="{Binding Property.Price, StringFormat='{0:C0}'}" />
            <Label
                Grid.Row="2"
                FontSize="16"
                LineBreakMode="NoWrap"
                Text="{Binding Property.Address}" />
            <Grid
                Grid.Row="3"
                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="10">
                <Label
                    Grid.Column="0"
                    FontFamily="FA-solid"
                    FontSize="16"
                    Text="{Static fa:IconFont.Bed}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    FontSize="16"
                    Text="{Binding Property.Beds}" />
                <Label
                    Grid.Column="2"
                    FontFamily="FA-solid"
                    FontSize="16"
                    Text="{Static fa:IconFont.Bath}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="3"
                    FontSize="16"
                    Text="{Binding Property.Baths}" />
                <Label
                    Grid.Column="4"
                    FontFamily="FA-solid"
                    FontSize="16"
                    Text="{Static fa:IconFont.Parking}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="5"
                    FontSize="16"
                    Text="{Binding Property.Parking}" />
            </Grid>
            <Label
                Grid.Row="4"
                FontSize="14"
                Text="{Binding Property.LandSize, StringFormat='Land size: {0} &#x33a1;'}" />
            
            <!-- Map Action Buttons -->
            <Grid Grid.Row="5"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,10,0,10">
                <Button
                    Grid.Column="0"
                    Command="{Binding OpenInMapsCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    FontFamily="FA-solid"
                    Text="{x:Static fa:IconFont.MapMarkedAlt}"
                    FontSize="16"
                    HeightRequest="50" />
                <Button
                    Grid.Column="1"
                    Command="{Binding OpenInNavigationCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontFamily="FA-solid"
                    Text="{x:Static fa:IconFont.Directions}"
                    FontSize="16"
                    HeightRequest="50" />
            </Grid>
            
            <!-- Description Section with Text-to-Speech -->
            <Grid Grid.Row="6" 
                  Margin="0,20,0,0"
                  ColumnDefinitions="*,Auto,Auto">
                <Label
                    Grid.Column="0"
                    FontAttributes="Bold"
                    FontSize="14"
                    Text="Description:"
                    VerticalOptions="Center" />
                
                <!-- Play Button (visible when not speaking) -->
                <Button
                    Grid.Column="1"
                    BackgroundColor="#6200ea"
                    Command="{Binding SpeakDescriptionCommand}"
                    FontFamily="FA-solid"
                    FontSize="16"
                    HeightRequest="40"
                    IsVisible="{Binding IsSpeaking, Converter={StaticResource InvertedBoolConverter}}"
                    Text="{x:Static fa:IconFont.Play}"
                    TextColor="White"
                    WidthRequest="50" />
                
                <!-- Stop Button (visible when speaking) -->
                <Button
                    Grid.Column="2"
                    BackgroundColor="#d32f2f"
                    Command="{Binding StopSpeakingCommand}"
                    FontFamily="FA-solid"
                    FontSize="16"
                    HeightRequest="40"
                    IsVisible="{Binding IsSpeaking}"
                    Text="{x:Static fa:IconFont.Stop}"
                    TextColor="White"
                    WidthRequest="50" />
            </Grid>
            
            <Label
                Grid.Row="7"
                Margin="0,0,0,20"
                FontSize="14"
                Text="{Binding Property.Description}" />

            <!-- Speech Controls (Advanced Features) -->
            <Grid Grid.Row="8" 
                  ColumnDefinitions="*,*"
                  ColumnSpacing="20"
                  IsVisible="{Binding IsSpeaking, Converter={StaticResource InvertedBoolConverter}}">
                
                <!-- Pitch Control -->
                <StackLayout Grid.Column="0">
                    <Label Text="Pitch" FontSize="12" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                        <Button Grid.Column="0"
                                Command="{Binding DecreasePitchCommand}"
                                Text="-"
                                FontSize="16"
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="LightGray" />
                        <Label Grid.Column="1"
                               Text="{Binding SpeechPitch, StringFormat='{0:F1}'}"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding IncreasePitchCommand}"
                                Text="+"
                                FontSize="16"
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="LightGray" />
                    </Grid>
                </StackLayout>

                <!-- Volume Control -->
                <StackLayout Grid.Column="1">
                    <Label Text="Volume" FontSize="12" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                        <Button Grid.Column="0"
                                Command="{Binding DecreaseVolumeCommand}"
                                Text="-"
                                FontSize="16"
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="LightGray" />
                        <Label Grid.Column="1"
                               Text="{Binding SpeechVolume, StringFormat='{0:F1}'}"
                               FontSize="12"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding IncreaseVolumeCommand}"
                                Text="+"
                                FontSize="16"
                                WidthRequest="30"
                                HeightRequest="30"
                                BackgroundColor="LightGray" />
                    </Grid>
                </StackLayout>
            </Grid>

            <Label
                Grid.Row="9"
                FontAttributes="Bold"
                FontSize="14"
                Text="Listed by:" />
            <Grid Grid.Row="10" ColumnDefinitions="auto, *">
                <Image
                    Grid.Column="0"
                    Source="{Binding Agent.ImageUrl}"
                    VerticalOptions="Start"
                    WidthRequest="100" />
                <Grid
                    Grid.Column="1"
                    Margin="10"
                    RowDefinitions="Auto,Auto,Auto">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="{Binding Agent.Name}" />
                    <Label
                        Grid.Row="1"
                        FontSize="12"
                        Text="{Binding Agent.Email}" />
                    <Label
                        Grid.Row="2"
                        FontSize="12"
                        Text="{Binding Agent.Phone}" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>