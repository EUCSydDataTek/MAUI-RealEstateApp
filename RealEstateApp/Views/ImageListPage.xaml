<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RealEstateApp.Views.ImageListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RealEstateApp.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:ImageListPageViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Property Info Header -->
        <StackLayout Grid.Row="0" Padding="20,10" BackgroundColor="LightGray">
            <Label Text="{Binding Property.Address}" 
                   FontSize="Medium" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Property.Price, StringFormat='{0:C0}'}" 
                   FontSize="Small" 
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- CarouselView for Images -->
        <CarouselView Grid.Row="1" 
                      ItemsSource="{Binding Images}"
                      Position="{Binding Position}"
                      BackgroundColor="Black">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type x:String}">
                    <Grid>
                        <Image Source="{Binding Path=.}" 
                               Aspect="AspectFit"
                               BackgroundColor="Black" />
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Image Info Footer -->
        <StackLayout Grid.Row="2" Padding="20,10" BackgroundColor="LightGray">
            <Label Text="{Binding CurrentImageDescription}" 
                   FontSize="Medium" 
                   HorizontalOptions="Center" />
            <Label Text="{Binding ShakeStatusMessage}" 
                   FontSize="Small" 
                   TextColor="DarkBlue"
                   HorizontalOptions="Center" />
            
            <!-- Accelerometer Display (Extra Task) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5">
                <Label Grid.Column="0" 
                       Text="{Binding AccelerometerX, StringFormat='X: {0:F2}'}" 
                       FontSize="Micro" 
                       HorizontalOptions="Center" />
                <Label Grid.Column="1" 
                       Text="{Binding AccelerometerY, StringFormat='Y: {0:F2}'}" 
                       FontSize="Micro" 
                       HorizontalOptions="Center" />
                <Label Grid.Column="2" 
                       Text="{Binding AccelerometerZ, StringFormat='Z: {0:F2}'}" 
                       FontSize="Micro" 
                       HorizontalOptions="Center" />
            </Grid>
        </StackLayout>

    </Grid>

</ContentPage>